# 红果短剧 4.5 源码候选：公开源码排除依赖、构建产物与本地运行资料。
/*-small.png

# 依赖
node_modules/
dist/
dist-react/

# 内置的 ffmpeg 二进制（约 167MB，从网络获取，不纳入版本管理）
# 打包前执行：node scripts/setup-ffmpeg.js 或手动放入 build/ffmpeg/
# 注意：许可证文本（*.txt / COPYING.* / LICENSE.md）必须随源码保留，
#       因此这里只忽略目录内容，再用反向规则把它们重新纳入。
build/ffmpeg/*
!build/ffmpeg/*.txt
!build/ffmpeg/COPYING.*
!build/ffmpeg/LICENSE.md

# 构建与打包输出
release/
out/
.webpack/
*.asar
*.exe
*.dmg
*.app
*.AppImage

# 临时文件与缓存
.zcode/
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
*.tmp
*.cache/
.npm-cache/
.electron-cache/
.eb-cache/

# 5.0 打包产物（electron-builder 的 directories.output）
/dist-5.0/
/web-5.0/

# Windows 版 FFmpeg 下载缓存（setup-ffmpeg.js 会落在 build/ 下）
build/ffmpeg-essentials.zip

