{
  "name": "hongguo-drama",
  "version": "5.0.0",
  "private": true,
  "description": "红果短剧播放与下载桌面端",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @hongguo/desktop dev",
    "build": "pnpm --filter @hongguo/desktop build",
    "build:dir": "pnpm --filter @hongguo/desktop build:dir",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "legacy:test": "node scripts/test.cjs",
    "clean:build": "tsc -b --clean && rm -rf apps/desktop/out packages/*/dist-types",
    "test:all": "NODE_ENV=test pnpm test && pnpm legacy:test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "axios": "1.21.0",
    "esbuild": "0.21.5",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.6",
    "semver": "7.7.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "electron": "45.1.0",
    "electron-updater": "6.8.11",
    "proxy-from-env": "2.1.0",
    "@playwright/test": "1.57.0"
  }
}
